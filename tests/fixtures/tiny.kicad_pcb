(kicad_pcb (version 20221018) (generator pcbnew)
  (gr_rect (start 100 50) (end 130 70) (layer "Edge.Cuts") (width 0.1))
  (footprint "Switch:BTN" (layer "F.Cu")
    (at 105 65 90)
    (property "Reference" "K1")
    (property "Value" "RESET")
    (pad "1" smd rect (at -2 0 90) (size 1 2) (layers "F.Cu") (net 1 "EN"))
    (pad "2" smd rect (at 2 0 90) (size 1 2) (layers "F.Cu") (net 2 "GND"))
  )
  (footprint "Led:LED" (layer "B.Cu")
    (at 120 55)
    (property "Reference" "D1")
    (property "Value" "RED")
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "B.Cu") (net 3 "LED"))
  )
)
